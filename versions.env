# Tested/pinned versions. Sourced by scripts/*.sh. Empty = not yet verified; scripts refuse to run.
# Verified 2026-10-29 against official GitHub releases (kind, argo-workflows) and `helm search repo`.

KIND_VERSION=v0.33.0
# Node image from the kind v0.33.0 release notes (K8s 1.36.4, within skew of kubectl v1.36.1).
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# Argo Workflows app version (GitHub latest release).
ARGO_VERSION=v4.1.6
# argo-helm chart whose appVersion matches ARGO_VERSION. Find with:
#   helm search repo argo/argo-workflows --versions
ARGO_CHART_VERSION=2.0.14

CLUSTER_NAME=mlops-k8s
ARGO_NAMESPACE=argo
WORKFLOW_NAMESPACE=ml-workflows

# Project 01 image (built locally, loaded into kind; never pulled). Pin by tag, not latest.
BASE_IMAGE=churn-pipeline:p01-local
STAGE_IMAGE=mlops-stages:local
CALICO_VERSION=v3.33.0
CALICO_MANIFEST_SHA256=2de8f47595fb9c41b3f47d7b767a1f8e72ecf84057af834738ff12689a234da5
# Calico images (index digests of $CALICO_VERSION), applied to the verified manifest by create-cluster.sh.
CALICO_CALICO_DIGEST=sha256:4ebc20730127bc9e8bf1db5f5a2d8b58cf37fe0e891b3c7b5471992221d213e5
CALICO_NODE_DIGEST=sha256:565d8db3200e443955557f8f28ff44ab8a4a456754bc74a19c4f2f3444af9b1c
CALICO_CNI_PLUGINS_DIGEST=sha256:0f32f48279484c0d6f0e0d0e767b2d0e1a6c6ca34cb3421a61b989d992f3df41
